{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    "/components.json",
    "src/bindings.gen.ts",
    "src/components/ui/**",
    "src/hooks/use-highlighted-code.ts",
    "src/hooks/use-mobile.ts",
    "src/lib/highlighter.tsx",
    "src/lib/utils.ts",
    "src/styles/globals.css"
  ]
}
